# Copy this file to .env.local and fill in your Supabase project values
# (Project Settings -> API in your Supabase dashboard)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# WhatsApp number that receives orders (with country code, no +, no spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=8801868561887

# ---- Optional shop settings -------------------------------------------------
# Public website address (used for share previews on WhatsApp / Facebook)
NEXT_PUBLIC_SITE_URL=https://your-shop.vercel.app
# Delivery charge outside Gaibandha Sadar (inside is free)
NEXT_PUBLIC_DELIVERY_OUTSIDE=120
# Mobile payment numbers shown at checkout (leave empty to hide)
NEXT_PUBLIC_BKASH_NUMBER=
NEXT_PUBLIC_NAGAD_NUMBER=
# Analytics (leave empty to disable)
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
